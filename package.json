{
  "name": "astrocare",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --env-file=.env server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "build:function": "tsc -p api/tsconfig.json",
    "preview": "vite preview",
    "test": "node --test server/proxy.test.mjs server/vercel.test.mjs src/components/spaceweather/client.test.mjs src/data/baseline.test.mjs src/lib/storage.test.mjs src/components/brief/integration.test.mjs src/components/demo/demo.test.mjs src/i18n/i18n.test.mjs",
    "test:brief": "node src/components/brief/contract.test.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
