# Copy to .env and fill in. Never commit .env.

# --- Frontend (Vite). VITE_ values are bundled into browser JS: no secrets. ---
# NASA DONKI solar-flare endpoint for the space-weather card. Optional: the
# default below is used when unset; on any failure the card shows cached data.
# No API key needed (api.nasa.gov/DONKI was retired 2026-09-30).
VITE_DONKI_FLR_URL=https://ccmc.gsfc.nasa.gov/DONKI-API/get/FLR

# --- Optional local proxy in server/ (P2). Not used by the app today; see
# server/README.md. Server-side only: never prefix these with VITE_. ---
NASA_API_KEY=
SERVER_PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5181
API_PROXY_TARGET=http://127.0.0.1:3001
