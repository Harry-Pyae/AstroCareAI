# Server-side values. Never expose these through VITE_ or client definitions.
# Never prefix a secret with VITE_ or paste a real key into this template.
NASA_API_KEY=
# On Vercel, set NASA_API_KEY in Project Settings > Environment Variables.
# These remaining settings are only for the two-process local dev workflow.
SERVER_PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5181
API_PROXY_TARGET=http://127.0.0.1:3001
