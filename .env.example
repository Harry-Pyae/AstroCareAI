# Copy to .env and fill in. Vite only exposes variables prefixed with VITE_,
# and they are bundled into the browser JS — never put secrets here.

# NASA API key for the DONKI space-weather card (free: https://api.nasa.gov).
# Optional: falls back to DEMO_KEY (rate-limited), then to cached data.
VITE_NASA_API_KEY=DEMO_KEY
