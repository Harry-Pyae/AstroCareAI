# Server-side only: read by api/space-weather.ts (the Vercel function).
# Set these in Vercel > Project Settings > Environment Variables, or in your
# shell for `npm run dev`. No VITE_ prefix: none of these may reach the browser.
# All three are optional. On any failure the card shows cached events.

# Used only when the function calls api.nasa.gov. The default CCMC endpoint
# needs no key, so none is sent to it.
NASA_API_KEY=
NASA_API_KEY_FALLBACK=

# Optional override of the DONKI solar-flare endpoint. Default when unset:
# https://ccmc.gsfc.nasa.gov/DONKI-API/get/FLR
DONKI_FLR_URL=
