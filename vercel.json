{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/space-weather.ts": { "maxDuration": 25 }
  },
  "rewrites": [{ "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }]
}
